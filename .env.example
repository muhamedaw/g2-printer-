# ════════════════════════════════════════════════
# MONEY PRINTER G2 — ENVIRONMENT VARIABLES
# Copy to .env and fill values. NEVER commit .env
# ════════════════════════════════════════════════

# ── Database ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mpg2
POSTGRES_USER=mpg2_user
POSTGRES_PASSWORD=change_this_32_char_minimum_password_here

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change_this_redis_password

# ── Auth ──────────────────────────────────────
JWT_SECRET=generate_with_openssl_rand_base64_64_minimum_32_chars
JWT_EXPIRY=7d

# ── Ollama (LOCAL AI — FREE FOREVER) ──────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# HOW TO INSTALL: https://ollama.ai
# HOW TO PULL MODELS: ollama pull llama3.2
# WHY: Zero API cost. Zero rate limits. Runs on your VPS forever.

# ── Solana ────────────────────────────────────
HELIUS_API_KEY=get_free_at_helius_dev
# HOW: helius.dev → Sign up → Dashboard → Create API Key
# Free tier: 100k credits/day

SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

WALLET_MASTER_SECRET=generate_with_openssl_rand_hex_32_minimum_32_chars
# AES-256 encryption key for trading wallet private keys
# Generate: openssl rand -hex 32

JITO_BLOCK_ENGINE=https://ny.mainnet.block-engine.jito.wtf

# ── Social Media (ALL FREE TIERS) ─────────────
TWITTER_BEARER_TOKEN=get_at_developer_twitter_com
TWITTER_API_KEY=get_at_developer_twitter_com
TWITTER_API_SECRET=get_at_developer_twitter_com
TWITTER_ACCESS_TOKEN=get_at_developer_twitter_com
TWITTER_ACCESS_SECRET=get_at_developer_twitter_com
# HOW: developer.twitter.com → Create project → Free basic tier

REDDIT_CLIENT_ID=get_at_reddit_com_prefs_apps
REDDIT_CLIENT_SECRET=get_at_reddit_com_prefs_apps
REDDIT_USER_AGENT=MoneyPrinterG2/1.0

TELEGRAM_API_ID=get_at_my_telegram_org
TELEGRAM_API_HASH=get_at_my_telegram_org
# HOW: my.telegram.org → API development tools → Create application

CRYPTOPANIC_API_KEY=get_free_at_cryptopanic_com_api

# ── Notifications ─────────────────────────────
TELEGRAM_BOT_TOKEN=get_from_botfather_on_telegram
TELEGRAM_CHAT_ID=your_personal_telegram_id
ADMIN_TELEGRAM_CHAT_ID=your_personal_chat_id_for_system_alerts
# Same as TELEGRAM_CHAT_ID if you are the admin. Used for downtime alerts.

# ── Monetization ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter_id
STRIPE_PRO_PRICE_ID=price_pro_id
STRIPE_WHALE_PRICE_ID=price_whale_id
# HOW: stripe.com → Create account → Dashboard → Products → Create prices

# ── App Config ────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEBHOOK_PORT=3003
DASHBOARD_PORT=3000
PAPER_TRADING=true
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# ── Trading Safety (OpenClaw hardening) ──────
# Max slippage in basis points. 100 = 1%, 50 = 0.5%
# Lower = safer but more trades may be rejected on thin liquidity
MAX_SLIPPAGE_BPS=100

# ── Whale Tracker (optional) ──────────────────
# Comma-separated Solana wallet addresses to track as "known whales"
SEED_WALLETS=

# ── Groq (FAST AI — FREE TIER — 14,400 req/day) ──
GROQ_API_KEY=get_free_at_console_groq_com
# HOW: console.groq.com → Sign in with Google → API Keys → Create key
# WHY: Replaces Ollama for sentiment analysis — 200ms vs 3-5s, no resource crash
# Model used: llama-3.1-8b-instant (free, unlimited on free tier)

# ── FREE APIs — NO KEY NEEDED ─────────────────
# DexScreener: api.dexscreener.com
# Jupiter:     quote-api.jup.ag
# RugCheck:    api.rugcheck.xyz
# GoPlus:      api.gopluslabs.io (no key needed)
# Pump.fun:    pumpportal.fun/api/data (WebSocket)
