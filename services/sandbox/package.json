{
  "name": "@mpg2/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/index.ts",
    "dev:watch": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev:test": "tsx --tsconfig tsconfig.json src/test-run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mpg2/db": "workspace:*",
    "@mpg2/shared": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.32.2",
    "grammy": "^1.27.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
